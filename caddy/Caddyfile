# Caddy serves SIEMLite with a certificate from Let's Encrypt that it gets and
# renews by itself. Used by compose.public.yaml; see "Run on the internet" in
# the README.
#
# The domain is chosen on SIEMLite's System page (or SIEMLITE_DOMAIN in .env),
# not here: before getting a certificate for a name, Caddy asks SIEMLite
# whether that is its domain, and SIEMLite says yes only for the one set. So
# changing the domain needs no restart, and nobody can make Caddy get
# certificates for names that aren't yours.
#
# Caddy passes each visitor's address on in X-Forwarded-For, and SIEMLite
# believes it only from Caddy (-trusted-proxies=caddy), so sign-in lockouts and
# the audit log see the visitor, not Caddy. Caddy drops any X-Forwarded-For a
# visitor sends, so it can't be forged.
{
	on_demand_tls {
		ask http://siemlite:8080/api/v1/caddy/ask
	}
}

https:// {
	tls {
		on_demand
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy siemlite:8080 {
		# Stream (backups can be gigabytes) instead of buffering.
		flush_interval -1
	}
}

http:// {
	redir https://{host}{uri} permanent
}
